# Copy this file to backend/.env and fill in real values for local development.
# Never commit the real .env file — it is already covered by .gitignore.

APP_NAME=Campus Social AI
ENV=development
DEBUG=true

# PostgreSQL connection string. Format:
# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://campus_app:campus_dev_pw@localhost:5432/campus_social

# Generate a real random secret for anything beyond local demo use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# AI provider: "mock" needs no key and works fully offline (default).
# Set to "openai" and provide AI_API_KEY to use a real model.
AI_PROVIDER=mock
AI_API_KEY=
AI_TEXT_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=dall-e-3
AI_DAILY_REQUEST_LIMIT_PER_USER=50
